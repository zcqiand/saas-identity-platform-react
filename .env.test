# .env.test — vitest 测试期覆盖（vitest mode=test 时加载，优先级高于 .env.local）
#
# Phase 2 单测真化（spec §3.2 / Task 10）：baseUrl 指真 saas-nextjs :5101（真服务由
# tests/global-setup.ts 保证在位：灌种子 saas_p2_test + 探活 + 铸真 JWT）。
# jsdom 侧已同步同源化（vitest.config.ts url=:5101，lab-react T7 实测：跨源 XHR
# 被吞成网络错误）。VITE_API_MODE 仅 UI 显示标签（backend-config.ts）。

VITE_API_BASE_URL=http://localhost:5101
VITE_API_MODE=nextjs

# dev server 端口契约(L0.5:三份 key 集合一致;test 不起 dev server,占位 dev 值)
VITE_DEV_PORT=5102

# B 方案 2026-09-11：登录页 clientId 兜底（saas-console 自身应用，ADR-0030 REQ-2026-001）
VITE_LOGIN_CLIENT_ID=saas-console
