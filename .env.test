# .env.test — vitest 测试期覆盖（vitest mode=test 时加载，优先级高于 .env.local）
#
# ADR-0014 + ADR-0012 v0.3.0：dev 用 .env.local（react → saas-msw HTTP :5100, MSW 模式 off）；
# test 用 .env.test（同源空 baseUrl，触发 setupServer）。
# ADR-0012 v0.3.0：删除 VITE_ENABLE_MSW（Service Worker 模式已删除，setupNodeMocks 无条件启用）。

VITE_API_BASE_URL=
VITE_API_MODE=msw-http
# dev server 端口契约(L0.5:三份 key 集合一致;test 不起 dev server,占位 dev 值)
VITE_DEV_PORT=5102

# B 方案 2026-09-11：登录页 clientId 兜底（saas-console 自身应用，ADR-0030 REQ-2026-001）
VITE_LOGIN_CLIENT_ID=11111111-1111-1111-1111-111111111114
