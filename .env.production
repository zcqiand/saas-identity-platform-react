# saas-identity-platform-react 生产环境变量(Vite build-time 烘焙)

# 后端地址 —— saas-react prod 直连 saas-springboot (v0.3.21 起修正双 /api/v1 前缀)。
#
# 历史：
#   v0.2.0 - v0.2.x: https://saas-nextjs.xiangru.uk (经 nextjs BFF)
#   v0.3.18: 改直连 https://saas-springboot.xiangru.uk/api/v1 (含路径前缀)
#   v0.3.21: 修正为 https://saas-springboot.xiangru.uk — 去掉 /api/v1 缀
#
# ⚠️ 不要在 baseURL 里加 /api/v1 前缀：
#   - orval 生成的 endpoint 路径已经是 '/api/v1/<resource>' (如 /api/v1/auth/login)
#   - axios baseURL + path = '/api/v1/api/v1/<resource>' 双前缀 → 401
#   - baseURL 应是 root URL (path prefix 是 endpoint 字符串的一部分)
# dev (.env.example) baseURL=http://localhost:5174 也无 /api/v1, 同样约定。
#
# VITE_API_MODE 仅 UI 标签 (不算真实模式), 显示成 'springboot' 与实际后端对齐。
VITE_API_BASE_URL=https://saas-springboot.xiangru.uk
VITE_API_MODE=springboot
# dev server 端口契约(L0.5:三份 key 集合一致;prod/test 不参与 dev server,占位 dev 值)
VITE_DEV_PORT=5173
